# Copy to .env and edit (used by docker-compose.penqle.yml).

# Full image reference override. By default Compose builds the local image;
# set this to a published image (e.g. ghcr.io/<owner>/tortoise-docker:penqle-bots)
# to pull instead.
# TURTLE_IMAGE=tortoise-docker:penqle-bots

# MariaDB
DB_ROOT_PASSWORD=changeme
DB_USER=mangos
DB_PASSWORD=mangos

# Database names (defaults match the core)
DB_LOGIN=tw_logon
DB_WORLD=tw_world
DB_CHAR=tw_char
DB_LOGS=tw_logs

# Realm / network — REALM_ADDRESS is what the *game client* uses to reach mangosd
REALM_NAME=TurtleWoW
REALM_ADDRESS=127.0.0.1
REALM_ID=1
REALM_PORT=3724
WORLD_PORT=8090
# Host address to bind the game ports to. 127.0.0.1 = local-only play;
# set to 0.0.0.0 so LAN clients can connect (then restart with docker compose up -d).
# GAME_BIND_IP=127.0.0.1

# Client data (dbc, maps, vmaps, mmaps) on the host
DATA_PATH=./data

# Server config files on the host, editable between restarts. Settings managed
# by an env var below are re-rendered on every start; everything else is kept.
CONFIG_PATH=./config

# Core settings
LOG_SQL=0
DATABASE_AUTOUPDATE_ENABLED=1

# World-tick budget. Continents update the cells around players and the motion
# of moving units on per-map thread pools. Upstream ships both knobs at 1,
# which means "no extra workers": every cell and every moving unit on a
# continent is processed on a single thread. With hundreds of bots roaming
# two continents that alone costs seconds per world tick, so raise the cell
# pool with the bot population (6 is a good start for ~1000 bots; each
# continent gets threads-1 workers). MotionUpdate is a plain worker count and
# is left at the upstream default.
MAPUPDATE_MTCELLS_THREADS=6
MAPUPDATE_MOTIONUPDATE_THREADS=1

# TortoiseBots (module ships with every service default-off; .env opts in)
# Requires RNDBOT-prefixed accounts/characters to exist — see README.
AI_PLAYERBOT_ENABLED=1
AI_MIN_RANDOM_BOTS=10
AI_MAX_RANDOM_BOTS=10
# Log bots in automatically after a restart (0/1); also gates the pool
# start-up (RandomBotLoginAtStartup)
AI_RANDOM_BOT_AUTOLOGIN=0
# Auto-create RNDBOT accounts/characters toward Min/MaxRandomBots (0/1),
# throttled to ~1 character per update interval
AI_RANDOM_BOT_AUTO_CREATE=0
# Let bots teleport around the world on their own (0/1)
AI_ENABLE_RANDOM_TELEPORTS=0
# Let random bots fill empty LFG/dungeon queues (0/1)
AI_RANDOM_BOT_LFT_ENABLED=0
# Let bots run a native auction-house market (0/1)
AI_AH_MARKET_ENABLED=0
# Per-tick bot activity budget. 1 (upstream default) = every bot runs a full
# AI tick on every world tick, so the world tick cost scales 1:1 with the bot
# population and upstream's advice is to lower the bot count instead. 0 =
# bots that are not near/visible to/grouped with a player share a rotating
# 10% activity budget (AiPlayerbot.botActiveAlone), which keeps a large
# population affordable; bots around a player stay fully active either way.
# Recommended 0 for populations in the hundreds or more.
AI_DISABLE_ACTIVITY_PRIORITIES=0
# Bot AI ticks per world tick divisor (needs the 012 patch in the image).
# 1 (default) = every eligible bot runs a full AI tick every world tick, so the
# world tick cost scales 1:1 with the pool. >1 staggers bots that no real player
# owns, groups, fights beside, or is within ReactDistance of: 3-5 for a few
# hundred bots, 5-10 for a thousand. Bots a player is involved with keep a full
# rate, and a skipped bot gets the skipped milliseconds back on its next run.
AI_BOT_AI_TICK_DIVISOR=1
# Whole random-bot pool stays offline until at least one human is online;
# all random bots log out when the last human leaves (0/1)
AI_RANDOM_BOT_LOGIN_WITH_PLAYER=1
# When a bot accepts a group invite it is teleported to the inviter
# (AzerothCore-style "SummonWhenGroup", 0/1)
AI_SUMMON_WHEN_GROUP=1

# On a ready check, bots top up missing/expiring buffs before reporting
# ready; a bot that cannot finish its buff work (e.g. out of reagents)
# reports not-ready. The "rebuff" chat command works regardless (0/1)
AI_FORCE_REBUFF_ON_READY_CHECK=0

# Failure backoff for bot background actions (milliseconds): a repeatedly
# failing action is skipped for base ms, doubling up to max, instead of being
# retried every tick. Defaults match the module; 0 disables the backoff.
AI_FAILED_ACTION_RETRY_BASE=250
AI_FAILED_ACTION_RETRY_MAX=2000

# Dungeon-clear module (vendored mod-dungeon-clear): autonomous 5-man
# dungeon clearing. Master toggle, default OFF (opt-in like every other
# background service). When enabled, drive it with `.dc on|off|skip|status`
# or the in-party keywords (`dc on`, `dungeon clear on`); tune the rest of
# the DungeonClear.* keys in config/modules/mod_dungeon_clear.conf.
DUNGEON_CLEAR_ENABLED=0

# Bot level range — see README "Bot levels" for how these interact
# 1 = all bots start at AI_RANDOM_BOT_STARTING_LEVEL and level up while the
#     realm runs; 0 = bots keep whatever level their character was created with
AI_DISABLE_RANDOM_LEVELS=0
AI_RANDOM_BOT_STARTING_LEVEL=1
# Upper level bound for random-bot gear/tuning (max 60)
AI_RANDOM_BOT_MAX_LEVEL=60
# Fresh pool bots get a random level in [MIN, MAX] once, on their first login
# (played time == 0), then level normally. Upstream default is 1/60, which
# spreads fresh bots over every level; 1/1 keeps the historic level-1 start.
# Changing this does not re-level characters that already exist.
AI_RANDOM_BOT_START_LEVEL_MIN=1
AI_RANDOM_BOT_START_LEVEL_MAX=60
# Level ladder (1 = on): pick the next bot to log in by level band so every
# band keeps a share of the online target; 0 = round-robin over the whole pool.
AI_LEVEL_LADDER=1
# Percent of the online target held for level 60 (a hard cap).
AI_LEVEL_LADDER_MAX_LEVEL_SHARE=10
# Bot XP multiplier (server XP rate * this).
AI_XPRATE=3
