+// Activity stagger (performance). At a large random-bot population the world
+// tick cost scales 1:1 with the number of bots, because every bot runs a full
+// AI tick every tick. Bots that no real player is involved with are instead
+// updated every `AiPlayerbot.BotAiTickDivisor` ticks (rotating by guid), which
+// removes most of that cost without taking anyone out of the world. Kept
+// deliberately conservative: every bot a player owns, groups, fights beside, or
+// could see keeps a full update rate.
+bool BotManager::ShouldStaggerAiThisTick(BotEntry const& entry, Player* player) const
+{
+    uint32_t const divisor = sPlayerbotAIConfig.botAiTickDivisor;
+    if (divisor <= 1 || !entry.record.random)
+        return false;
+
+    if (entry.record.masterGuid || entry.record.ownerAccountId)
+        return false;
+    if (!player || player->IsInCombat() || player->GetGroup())
+        return false;
+
+    float const range = sPlayerbotAIConfig.reactDistance > 0.0f
+        ? sPlayerbotAIConfig.reactDistance : 150.0f;
+    if (HasRealPlayerWithin(player, range))
+        return false;
+
+    return ((entry.record.characterGuid.GetCounter() + m_aiTickCounter) % divisor) != 0;
+}
+
+// Cache the real players (sessions with a network transport) in world once per
+// UpdateBots pass. The stagger gate asks "is a real player near this bot" for
+// every eligible pool bot, so rescanning the whole session map per bot is
+// O(pool x sessions): with a thousand bots that scan is most of the gate cost.
+// Sessions are serviced before the module tick, so the set is stable for the
+// pass.
+void BotManager::RefreshRealPlayers()
+{
+    m_realPlayers.clear();
+    for (auto const& sessionEntry : sWorld.GetAllSessions())
+    {
+        WorldSession* session = sessionEntry.second;
+        if (!session || !session->HasNetworkTransport())
+            continue;
+
+        Player* player = session->GetPlayer();
+        if (player && player->IsInWorld())
+            m_realPlayers.push_back(player);
+    }
+}
+
+bool BotManager::HasRealPlayerWithin(Player* bot, float range) const
+{
+    if (m_realPlayers.empty())
+        return false;
+
+    float const rangeSq = range * range;
+    for (Player* player : m_realPlayers)
+    {
+        if (!player || player == bot || player->GetMapId() != bot->GetMapId())
+            continue;
+
+        float const dx = player->GetPositionX() - bot->GetPositionX();
+        float const dy = player->GetPositionY() - bot->GetPositionY();
+        if ((dx * dx + dy * dy) <= rangeSq)
+            return true;
+    }
+    return false;
+}
