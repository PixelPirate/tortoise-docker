 using namespace ai;
 
+// Non-raid dungeons only: open world, raids and battlegrounds keep generic CC.
+// Per-dungeon instance strategies register their own named CC and are not
+// derived from CcStrategy, so they are never suppressed here.
+bool ai::IsGenericCcSuppressedInDungeon(PlayerbotAI* ai)
+{
+    return ai->IsInNonRaidDungeon();
+}
 
