+bool Trigger::needCheck()
+{
+	// During an out-of-combat force-rebuff (mod-playerbots PR #2571), evaluate
+	// every buff trigger each tick so the pass tops up all buffs immediately.
+	if (IsBuffTrigger() && !IsDebuffTrigger() && ai->forceRebuff.IsPending() && !bot->IsInCombat())
+		return true;
+
+	if (checkInterval < 2)
+		return true;
+
+	time_t now = time(0);
+	if (!lastCheckTime || now - lastCheckTime >= checkInterval)
+	{
+		lastCheckTime = now;
+		return true;
+	}
+	return false;
+}
