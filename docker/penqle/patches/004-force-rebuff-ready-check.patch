diff --git a/ai/playerbot/strategy/generic/ForceRebuff.cpp b/ai/playerbot/strategy/generic/ForceRebuff.cpp
new file mode 100644
index 0000000..f69f45f
--- /dev/null
+++ b/ai/playerbot/strategy/generic/ForceRebuff.cpp
@@ -0,0 +1,114 @@
+/*
+ * Port of mod-playerbots PR #2571 (Force rebuff on ready check), adapted to
+ * TortoiseBots: donor behavior kept (2-minute staleness ceiling, buff-first
+ * heal suppression, not-ready until buff work drains), donor plumbing that
+ * has no Tortoise equivalent (GroupVariant upgrade path, ai::buff namespace)
+ * reduced to the aura-duration checks Tortoise's buff actions and values use.
+ */
+#include "ForceRebuff.h"
+
+#include "playerbot/PlayerbotAI.h"
+#include "playerbot/PlayerbotAIConfig.h"
+#include "playerbot/strategy/actions/GenericSpellActions.h"
+
+#include "SpellAuras.h"
+#include "Timer.h"
+
+#include <algorithm>
+
+using namespace ai;
+
+static constexpr uint32 REBUFF_WINDOW_TIMEOUT_MS = 2 * MINUTE * IN_MILLISECONDS;
+
+void ForceRebuffState::Begin(bool reply)
+{
+    replyToReadyCheck = reply || (IsPending() && replyToReadyCheck);
+    pending = true;
+    buffPendingThisCycle = true;
+    beginMs = WorldTimer::getMSTime();
+}
+
+bool ForceRebuffState::IsPending() const
+{
+    return pending && WorldTimer::getMSTimeDiff(beginMs, WorldTimer::getMSTime()) < REBUFF_WINDOW_TIMEOUT_MS;
+}
+
+bool ForceRebuffState::IsOnGlobalCooldown() const
+{
+    // Unit carries the global-cooldown state on this core.
+    return bot && lastGcdSpell &&
+           bot->GetGlobalCooldownMgr().HasGlobalCooldown(lastGcdSpell);
+}
+
+void ForceRebuffState::NoteBuffWork()
+{
+    if (!bot || !IsPending() || bot->IsInCombat())
+        return;
+
+    buffPendingThisCycle = true;
+}
+
+void ForceRebuffState::NoteBuffProposed()
+{
+    if (!bot || !IsPending() || bot->IsInCombat())
+        return;
+
+    buffProposedThisCycle = true;
+}
+
+bool ForceRebuffState::BuffBelowRefreshTarget(int32 remaining, int32 maxDuration, uint32 baseBeforeDuration) const
+{
+    if (bot && IsPending() && !bot->IsInCombat())
+    {
+        if (remaining <= 0 || maxDuration <= 0)
+            return false;
+
+        // Anything refreshed after the rebuff began counts as topped off.
+        uint32 const marginMs = std::max(sPlayerbotAIConfig.forceRebuffMarginSecs * IN_MILLISECONDS,
+                                         WorldTimer::getMSTimeDiff(beginMs, WorldTimer::getMSTime()) + 5000u);
+        return uint32(remaining) + marginMs < uint32(maxDuration);
+    }
+
+    return baseBeforeDuration && uint32(remaining) < baseBeforeDuration;
+}
+
+bool ai::BuffBelowRefreshTarget(PlayerbotAI* ai, Aura* aura, uint32 baseBeforeDuration)
+{
+    if (!aura)
+        return true;
+
+    return ai->forceRebuff.BuffBelowRefreshTarget(aura->GetAuraDuration(), aura->GetAuraMaxDuration(), baseBeforeDuration);
+}
+
+// During a force-rebuff, healing yields to buffing: heals are suppressed while
+// buff work is proposed or the last cast's GCD runs, so the pass is not
+// stretched by interleaved heals.
+class ForceRebuffBuffFirstMultiplier : public Multiplier
+{
+public:
+    ForceRebuffBuffFirstMultiplier(PlayerbotAI* ai) : Multiplier(ai, "force rebuff buff first") {}
+
+    float GetValue(Action* action) override
+    {
+        ForceRebuffState const& rebuff = ai->forceRebuff;
+        if (!action || !rebuff.IsPending() || ai->GetBot()->IsInCombat())
+            return 1.0f;
+
+        if (!dynamic_cast<CastHealingSpellAction*>(action))
+            return 1.0f;
+
+        return rebuff.IsBuffProposedThisCycle() || rebuff.IsOnGlobalCooldown() ? 0.0f : 1.0f;
+    }
+};
+
+void ForceRebuffStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    triggers.push_back(new TriggerNode(
+        "force rebuff pending",
+        NextAction::array(0, new NextAction("ready reply", 6.0f), NULL)));
+}
+
+void ForceRebuffStrategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
+{
+    multipliers.push_back(new ForceRebuffBuffFirstMultiplier(ai));
+}
