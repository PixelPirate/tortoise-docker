diff --git a/ai/playerbot/strategy/values/CreatureIdValue.cpp b/ai/playerbot/strategy/values/CreatureIdValue.cpp
new file mode 100644
index 0000000..8dffffb
--- /dev/null
+++ b/ai/playerbot/strategy/values/CreatureIdValue.cpp
@@ -0,0 +1,81 @@
+
+#include "playerbot/playerbot.h"
+#include "CreatureIdValue.h"
+#include "playerbot/PlayerbotAIConfig.h"
+
+using namespace ai;
+
+static uint32 FindCreatureIdByName(const std::string& namepart)
+{
+    const CreatureInfoMap& creatures = sObjectMgr.GetCreatureInfoMap();
+
+    std::string wanted;
+    wanted.reserve(namepart.size());
+    for (char c : namepart)
+    {
+        wanted.push_back((char)tolower(c));
+    }
+
+    uint32 exactMatch = 0;
+    uint32 partialMatch = 0;
+    bool partialAmbiguous = false;
+    for (const auto& itr : creatures)
+    {
+        const std::string& name = itr.second->name;
+        std::string lowered;
+        lowered.reserve(name.size());
+        for (char c : name)
+        {
+            lowered.push_back((char)tolower(c));
+        }
+
+        if (lowered == wanted)
+        {
+            if (!exactMatch || exactMatch == itr.first)
+                exactMatch = itr.first;
+            else
+                return 0; // ambiguous: two entries share the name
+        }
+        else if (lowered.find(wanted) != std::string::npos)
+        {
+            if (partialMatch && partialMatch != itr.first)
+                partialAmbiguous = true;
+            else
+                partialMatch = itr.first;
+        }
+    }
+
+    if (exactMatch)
+        return exactMatch;
+
+    return partialAmbiguous ? 0 : partialMatch;
+}
+
+CreatureIdValue::CreatureIdValue(PlayerbotAI* ai) : CalculatedValue<uint32>(ai, "creature id", 10), Qualified()
+{
+}
+
+uint32 CreatureIdValue::Calculate()
+{
+    std::string namepart = qualifier;
+
+    // Plain entry id first; the core has no creature-link extractor, so links
+    // resolve only through their visible name text.
+    if (!namepart.empty() && namepart.find_first_not_of("0123456789") == std::string::npos)
+    {
+        const uint32 entryId = atoi(namepart.c_str());
+        if (entryId && sObjectMgr.GetCreatureTemplate(entryId))
+            return entryId;
+
+        return 0;
+    }
+
+    if (namepart.empty())
+        return 0;
+
+    const uint32 namedId = FindCreatureIdByName(namepart);
+    if (namedId && sObjectMgr.GetCreatureTemplate(namedId))
+        return namedId;
+
+    return 0;
+}
