+        AttackThaddiusPetAction(PlayerbotAI* ai) : AttackAction(ai, "attack thaddius pet") {}
+
+        bool Execute(Event& event) override
+        {
+            Unit* currentTarget = AI_VALUE(Unit*, "current target");
+            if (currentTarget && currentTarget->IsAlive() &&
+                (currentTarget->GetEntry() == 15929 || currentTarget->GetEntry() == 15930))
+                return false;
+
+            return AttackAction::Execute(event);
+        }
+
+    protected:
+        virtual Unit* GetTarget() override
+        {
+            Unit* stalagg = FindDungeonBoss(ai, 15929);
+            Unit* feugen = FindDungeonBoss(ai, 15930);
+
+            if (!stalagg)
+                return feugen;
+            if (!feugen)
+                return stalagg;
+
+            return bot->GetDistance(stalagg) < bot->GetDistance(feugen) ? stalagg : feugen;
