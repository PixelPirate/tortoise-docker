+
+    // Step away from the nearest opposite-charge group member.
+    class ThaddiusPolaritySpreadAction : public MovementAction
+    {
+    public:
+        ThaddiusPolaritySpreadAction(PlayerbotAI* ai) : MovementAction(ai, "thaddius polarity spread") {}
+
+        bool Execute(Event& event) override
+        {
+            const bool positive = ai->HasAura(28059, bot);
+            const uint32 opposite = positive ? 28084u : 28059u;
+
+            Group* group = bot->GetGroup();
+            if (!group)
+                return false;
+
+            Player* closest = nullptr;
+            float closestDist = FLT_MAX;
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            {
+                Player* member = ref->GetSource();
+                if (!member || member == bot || !member->IsAlive() || member->GetMapId() != bot->GetMapId())
+                    continue;
+
+                if (!ai->HasAura(opposite, member))
+                    continue;
+
+                float dist = bot->GetDistance(member);
+                if (dist < closestDist)
+                {
+                    closestDist = dist;
+                    closest = member;
+                }
+            }
+
+            if (!closest || closestDist >= 12.0f)
+                return false;
+
+            float angle = bot->GetAngle(closest) + M_PI_F;
+            float travel = 12.0f - closestDist + 2.0f;
+            float x = bot->GetPositionX() + cos(angle) * travel;
+            float y = bot->GetPositionY() + sin(angle) * travel;
+            return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ());
+        }
+    };
