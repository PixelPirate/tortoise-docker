+    // Deep breath reaction: the donor used precomputed 3.3.5-lair safe-zone
+    // coordinates, which do not transfer to the classic lair. Ported as
+    // corridor-relative movement instead: the breath travels along the
+    // direction Onyxia faces at cast time, so the bot moves perpendicular
+    // out of the breath band (25y half-width, targeting 30y lateral offset).
+    class OnyxiaMoveOutOfBreathAction : public MovementAction
+    {
+    public:
+        OnyxiaMoveOutOfBreathAction(PlayerbotAI* ai) : MovementAction(ai, "move out of onyxia breath") {}
+
+        bool Execute(Event& event) override
+        {
+            Unit* boss = FindDungeonBoss(ai, 10184);
+            if (!boss)
+                return false;
+
+            Spell* currentSpell = boss->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+            if (!currentSpell || !currentSpell->m_spellInfo)
+                return false;
+
+            switch (currentSpell->m_spellInfo->Id)
+            {
+                case 17086:
+                case 18351:
+                case 18576:
+                case 18609:
+                case 18564:
+                case 18584:
+                case 18596:
+                case 18617:
+                    break;
+                default:
+                    return false;
+            }
+
+            float dx = bot->GetPositionX() - boss->GetPositionX();
+            float dy = bot->GetPositionY() - boss->GetPositionY();
+            float dist = sqrt(dx * dx + dy * dy);
+            if (dist > 70.0f)
+                return false;
+
+            float breathAngle = boss->GetOrientation();
+            float botAngle = atan2(dy, dx);
+            float diff = fabs(botAngle - breathAngle);
+            if (diff > M_PI_F)
+                diff = 2 * M_PI_F - diff;
+
+            if (diff > M_PI_F * 0.55f)
+                return false;
+
+            float lateral = dist * sin(diff);
+            if (lateral >= 25.0f)
+                return false;
+
+            float side = (sin(botAngle - breathAngle) >= 0.0f) ? 1.0f : -1.0f;
+            float moveAngle = breathAngle + side * M_PI_F * 0.5f;
+            float travel = 30.0f - lateral + 5.0f;
+
+            float x = bot->GetPositionX() + cos(moveAngle) * travel;
+            float y = bot->GetPositionY() + sin(moveAngle) * travel;
+            return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ());
+        }
+    };
+
+    // Non-tank too close to front/tail: step to the boss's flank (the side
+    // the bot is already on).
+    class OnyxiaMoveToSideAction : public MovementAction
+    {
+    public:
+        OnyxiaMoveToSideAction(PlayerbotAI* ai) : MovementAction(ai, "move to onyxia side") {}
+
+        bool Execute(Event& event) override
+        {
+            Unit* boss = FindDungeonBoss(ai, 10184);
+            if (!boss)
+                return false;
+
+            float dx = bot->GetPositionX() - boss->GetPositionX();
+            float dy = bot->GetPositionY() - boss->GetPositionY();
+            float botAngle = atan2(dy, dx);
+
+            float side = (sin(botAngle - boss->GetOrientation()) >= 0.0f) ? 1.0f : -1.0f;
+            float sideAngle = boss->GetOrientation() + side * M_PI_F * 0.5f;
+
+            float x = boss->GetPositionX() + cos(sideAngle) * 20.0f;
+            float y = boss->GetPositionY() + sin(sideAngle) * 20.0f;
+            return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ());
+        }
+    };
+
+    // The bot is the Fireball target: spread from the nearest friendly.
+    class OnyxiaSpreadOutAction : public MovementAction
+    {
+    public:
+        OnyxiaSpreadOutAction(PlayerbotAI* ai) : MovementAction(ai, "spread from onyxia fireball") {}
+
+        bool Execute(Event& event) override
+        {
+            Unit* boss = FindDungeonBoss(ai, 10184);
+            if (!boss)
+                return false;
+
+            Spell* currentSpell = boss->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+            if (!currentSpell || !currentSpell->m_spellInfo || currentSpell->m_spellInfo->Id != 18392)
+                return false;
+
+            Unit* spellTarget = currentSpell->m_targets.getUnitTarget();
+            if (!spellTarget || spellTarget != bot)
+                return false;
+
+            Group* group = bot->GetGroup();
+            if (!group)
+                return false;
+
+            Player* closest = nullptr;
+            float closestDist = FLT_MAX;
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            {
+                Player* member = ref->GetSource();
+                if (!member || member == bot || !member->IsAlive() || member->GetMapId() != bot->GetMapId())
+                    continue;
+
+                float dist = bot->GetDistance(member);
+                if (dist < closestDist)
+                {
+                    closestDist = dist;
+                    closest = member;
+                }
+            }
+
+            if (!closest || closestDist >= 9.0f)
+                return false;
+
+            float angle = bot->GetAngle(closest) + M_PI_F;
+            float travel = 9.0f - closestDist + 2.0f;
+            float x = bot->GetPositionX() + cos(angle) * travel;
+            float y = bot->GetPositionY() + sin(angle) * travel;
+            return MoveTo(bot->GetMapId(), x, y, bot->GetPositionZ());
+        }
+    };
+
+    // Phase 2: non-healers switch to the nearest Onyxian Whelp.
+    class OnyxiaKillWhelpsAction : public AttackAction
+    {
+    public:
+        OnyxiaKillWhelpsAction(PlayerbotAI* ai) : AttackAction(ai, "attack onyxian whelp") {}
+
+        bool Execute(Event& event) override
+        {
+            Unit* currentTarget = AI_VALUE(Unit*, "current target");
+            if (currentTarget && currentTarget->IsAlive() && currentTarget->GetEntry() == 11262)
+                return false;
+
+            return AttackAction::Execute(event);
+        }
+
+    protected:
+        virtual Unit* GetTarget() override
+        {
+            Unit* closest = nullptr;
+            float closestDist = FLT_MAX;
+
+            const std::list<ObjectGuid> candidates = AI_VALUE(std::list<ObjectGuid>, "possible targets");
+            for (const ObjectGuid& guid : candidates)
+            {
+                Unit* unit = ai->GetUnit(guid);
+                if (!unit || !unit->IsAlive() || unit->GetEntry() != 11262)
+                    continue;
+
+                float dist = bot->GetDistance(unit);
+                if (dist < closestDist)
+                {
+                    closestDist = dist;
+                    closest = unit;
+                }
+            }
+
+            return closest;
+        }
+    };
 }
