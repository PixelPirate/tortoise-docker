+    // Escape magma: move to the nearest dry group member (the raid fights on
+    // rock shelves, so a dry teammate marks the closest safe floor).
+    class McMoveFromLavaAction : public MovementAction
+    {
+    public:
+        McMoveFromLavaAction(PlayerbotAI* ai) : MovementAction(ai, "move from mc lava") {}
+
+        bool IsInMagma(Unit* unit) const
+        {
+            const TerrainInfo* terrain = WorldPosition(unit).GetTerrain();
+            if (!terrain)
+                return false;
+
+            GridMapLiquidData liquid;
+            GridMapLiquidStatus status = terrain->getLiquidStatus(unit->GetPositionX(), unit->GetPositionY(),
+                                                                  unit->GetPositionZ(), MAP_ALL_LIQUIDS, &liquid);
+            if (status == LIQUID_MAP_NO_WATER)
+                return false;
+
+            return (liquid.type_flags & MAP_LIQUID_TYPE_MAGMA) &&
+                   (status & (LIQUID_MAP_WATER_WALK | LIQUID_MAP_IN_WATER | LIQUID_MAP_UNDER_WATER));
+        }
+
+        bool Execute(Event& event) override
+        {
+            Player* dryTarget = nullptr;
+            float bestDist = 100.0f;
+
+            Group* group = bot->GetGroup();
+            if (!group)
+                return false;
+
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+            {
+                Player* member = ref->GetSource();
+                if (!member || member == bot || !member->IsAlive() || member->GetMapId() != bot->GetMapId())
+                    continue;
+
+                if (IsInMagma(member))
+                    continue;
+
+                float dist = bot->GetDistance(member);
+                if (dist < bestDist)
+                {
+                    bestDist = dist;
+                    dryTarget = member;
+                }
+            }
+
+            // No dry raid member in range: stay put and let the in-lava
+            // trigger refire; any other destination can path back into the pool.
+            if (!dryTarget)
+                return false;
+
+            return MoveTo(dryTarget->GetMapId(), dryTarget->GetPositionX(), dryTarget->GetPositionY(),
+                          dryTarget->GetPositionZ());
+        }
