+Unit* FindDungeonBoss(PlayerbotAI* ai, uint32 entry)
+{
+    const std::list<ObjectGuid> attackers = AI_VALUE(std::list<ObjectGuid>, "attackers");
+    for (const ObjectGuid& guid : attackers)
+    {
+        Unit* unit = ai->GetUnit(guid);
+        if (unit && unit->IsAlive() && unit->GetEntry() == entry)
+            return unit;
+    }
+
+    const std::list<ObjectGuid> possible = AI_VALUE(std::list<ObjectGuid>, "possible targets");
+    for (const ObjectGuid& guid : possible)
+    {
+        Unit* unit = ai->GetUnit(guid);
+        if (unit && unit->IsAlive() && unit->GetEntry() == entry && unit->IsInCombat())
+            return unit;
+    }
+
+    return nullptr;
+}
+
+bool BossCastingSpellTrigger::IsActive()
+{
+    Unit* boss = FindDungeonBoss(ai, bossEntry);
+    if (!boss)
+        return false;
+
+    Spell* currentSpell = boss->GetCurrentSpell(channeled ? CURRENT_CHANNELED_SPELL : CURRENT_GENERIC_SPELL);
+    if (!currentSpell || !currentSpell->m_spellInfo)
+        return false;
+
+    const uint32 spellId = currentSpell->m_spellInfo->Id;
+    return std::find(spellIds.begin(), spellIds.end(), spellId) != spellIds.end();
+}
