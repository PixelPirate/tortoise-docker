+    // Non-tank standing too close to Onyxia's front or tail arc while she is
+    // engaged (knockback / tail sweep risk).
+    class OnyxiaNearTailTrigger : public Trigger
+    {
+    public:
+        OnyxiaNearTailTrigger(PlayerbotAI* ai) : Trigger(ai, "onyxia near tail", 1) {}
+
+        bool IsActive() override
+        {
+            if (PlayerbotAI::IsTank(bot))
+                return false;
+
+            Unit* boss = FindDungeonBoss(ai, 10184);
+            if (!boss || !boss->GetVictim())
+                return false;
+
+            if (bot->GetDistance(boss) > 30.0f)
+                return false;
+
+            float diff = fabs(boss->GetAngle(bot) - boss->GetOrientation());
+            if (diff > M_PI_F)
+                diff = 2 * M_PI_F - diff;
+
+            return diff < M_PI_F / 4 || diff > 3 * M_PI_F / 4;
+        }
+    };
