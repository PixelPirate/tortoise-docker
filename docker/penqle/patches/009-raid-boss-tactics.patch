+
+    // Heigan dance: move to the safe quadrant for the upcoming eruption.
+    // The fight clock lives in the action (it owns the state): fight phase
+    // is 90s (eruptions at 15s then every 10s), dance phase 45s (eruptions
+    // at 4s then every 3s), detected via the boss channeling Plague Cloud
+    // (29350). The safe quadrant per eruption index follows the core
+    // script's section-skip pattern: {0,1,2,3,2,1}[index % 6]. Waypoints
+    // are the four quadrant centres of Heigan's room (map 533, donor PR
+    // #2671 lineage; implementation-verified, gameplay-untested). The
+    // donor's ranged platform hold is NOT ported: Turtle's encounter data
+    // does not confirm a player-safe platform, so everyone dances the
+    // floor (fail-closed).
+    class MoveToHeiganSafeSpotAction : public MovementAction
+    {
+    public:
+        MoveToHeiganSafeSpotAction(PlayerbotAI* ai) : MovementAction(ai, "move to heigan safe spot") {}
+
+        static const uint32 WaypointCount = 4;
+        static const float WaypointX[WaypointCount];
+        static const float WaypointY[WaypointCount];
+        static const float SafeSpotTolerance;
+
+        bool Execute(Event& event) override
+        {
+            Unit* boss = FindDungeonBoss(ai, 15936);
+            if (!boss)
+            {
+                combatStart = 0;
+                phaseStart = 0;
+                wasDance = false;
+                return false;
+            }
+
+            bool dancing = false;
+            if (Spell* channel = boss->GetCurrentSpell(CURRENT_CHANNELED_SPELL))
+                dancing = channel->m_spellInfo && channel->m_spellInfo->Id == 29350;
+
+            const uint32 now = WorldTimer::getMSTime();
+            if (combatStart == 0)
+                combatStart = now;
+
+            if (dancing != wasDance)
+            {
+                wasDance = dancing;
+                phaseStart = now;
+            }
+
+            uint32 elapsed = now - phaseStart;
+            uint32 firstEruption = dancing ? 4000 : 15000;
+            uint32 interval = dancing ? 3000 : 10000;
+
+            static const uint8 safeSection[6] = {0, 1, 2, 3, 2, 1};
+
+            uint32 eruptionIndex = (elapsed < firstEruption)
+                ? 0
+                : (elapsed - firstEruption) / interval + 1;
+
+            uint32 safe = safeSection[eruptionIndex % 6];
+
+            float dxSafe = bot->GetPositionX() - WaypointX[safe];
+            float dySafe = bot->GetPositionY() - WaypointY[safe];
+            if (sqrt(dxSafe * dxSafe + dySafe * dySafe) <= SafeSpotTolerance)
+                return false;
+
+            return MoveTo(bot->GetMapId(), WaypointX[safe], WaypointY[safe], bot->GetPositionZ());
+        }
+
+    private:
+        uint32 combatStart = 0;
+        uint32 phaseStart = 0;
+        bool wasDance = false;
+    };
+
+    // Pet phase: attack the nearest live Stalagg/Feugen instead of the
