+bool BotManager::ClaimIdleBot(::ObjectGuid guid, IdleBotClaimant claimant)
+{
+    if (guid.IsEmpty() || claimant == IdleBotClaimant::None)
+        return false;
+    // Only module-owned bots are arbitrable; players/unknown guids fail closed.
+    if (!IsBot(guid))
+        return false;
+
+    uint32_t key = guid.GetCounter();
+    std::unordered_map<uint32_t, std::pair<uint32_t, IdleBotClaimant>>::iterator it = m_idleClaims.find(key);
+    if (it != m_idleClaims.end() && it->second.first == m_arbitrationTick)
+        return it->second.second == claimant;
+
+    m_idleClaims[key] = std::make_pair(m_arbitrationTick, claimant);
+    return true;
+}
