+void LftBotFillService::DrainStaleLftQueue()
+{
+    // F25 restart-orphan drain. The core LFT queue/offer state is in-memory,
+    // so a cold realm start has nothing to drain; this covers a warm re-init
+    // where entries survived for characters that no longer have a live
+    // session. One-shot at init, no background polling: LeaveQueue is the
+    // native single-owner cancellation path (queue, rolecheck, offer). An
+    // error here only skips the cleanup - the bot is never disabled.
+    std::vector<LFTManager::QueuedInfo> queued = sLFTMgr.GetQueuedPlayers();
+    for (auto const& entry : queued)
+    {
+        if (entry.guid.IsEmpty())
+            continue;
+        if (sObjectAccessor.FindPlayer(entry.guid))
+            continue; // a live session still owns the entry
+        if (sLFTMgr.LeaveQueue(entry.guid))
+            sLog.outString("TortoiseBots: LFT fill drained stale queue entry guid %u at init",
+                entry.guid.GetCounter());
+    }
+    m_pending.clear();
+}
