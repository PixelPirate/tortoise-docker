+void BattlegroundQueueService::DrainStaleBattlegroundData()
+{
+    // F25 restart-orphan drain. Core BG queue memberships are in-memory and
+    // do not survive a realm restart (the core also expires offline queue
+    // entries itself), but the character_battleground_data rows a bot saved
+    // while queued do persist. For a sessionless module bot character such a
+    // row is always stale, so clear it deterministically here. Scoped to the
+    // configured random-bot account pool, never to human characters; offline
+    // human rows keep the core's own relogin handling. One-shot at world
+    // startup (no players are online yet); no background polling, and an
+    // error here only skips the cleanup - the bot is never disabled.
+    std::string prefix = sPlayerbotAIConfig.randomBotAccountPrefix;
+    if (prefix.empty())
+        return;
+    CharacterDatabase.escape_string(prefix);
+    CharacterDatabase.PExecute(
+        "DELETE cbd FROM character_battleground_data AS cbd "
+        "JOIN characters AS c ON c.guid = cbd.guid "
+        "JOIN account AS a ON a.id = c.account "
+        "WHERE c.online = 0 AND a.username LIKE '%s%%'",
+        prefix.c_str());
+}
