+// --- map-wide loaded-object scans --------------------------------------------
+// The donor core exposed Map::GetCreatureBySpawnIdStore() /
+// GetGameObjectBySpawnIdStore() — one registry of every loaded creature/GO,
+// keyed by spawn id. Penqle's registry IS the grid containers, enumerated by a
+// grid visit around a center. The scan radius (dungeons are small; DC never
+// scans outside one) and dont_load=true preserve the donor semantics: only
+// objects the core has already loaded, no grid activation as a side effect.
+namespace DcGrid
+{
+    class AllUnitsInRange
+    {
+        public:
+            AllUnitsInRange(WorldObject const* obj, float range) : m_obj(obj), m_range(range) {}
+            bool operator() (Unit* u) const
+            { return u && m_obj && m_obj->IsWithinDist(u, m_range, false); }
+        private:
+            WorldObject const* m_obj;
+            float m_range;
+    };
+}
