+// Zeiger; die Tests wollen weiter einen Wert vergleichen.
+static std::vector<WaypointHint> DcTestRouteAnchors(uint32 mapId, Difficulty diff, uint32 boss)
+{
+    std::vector<WaypointHint> out;
