+// ---- GetMap semantics -------------------------------------------------------
+// This engine's WorldObject::GetMap() THROWS (std::runtime_error) when the
+// object is between maps; AzerothCore's returns whatever pointer it holds and
+// the module null-checks it everywhere. The first port shipped a
+//  here - DO NOT bring it back: the define made every
+// inline function that both module and bot TUs emit diverge in body while
+// keeping one linker-folded copy (COMDAT), and the folded EXCEPTION LANDING
+// PADS (.cold clones) then ran the wrong cleanup during unwinds - a wave of
+// free()/_Unwind_Resume crashes on the map pool threads. The module sources
+// call FindMap() directly instead (mechanical ->FindMap() -> ->FindMap()
+// rewrite); FindMap is byte-for-byte AC's GetMap body: return m_currMap.
+
+// AzerothCore's ObjectAccessor::GetCreature/GetUnit/GetGameObject/
+// GetDynamicObject: resolve a guid ON THE SAME MAP as the reference object
+// (world-object-first argument). This core keeps those getters on Map and its
+// ObjectAccessor only knows FindPlayer, so the same lookups go through the
+// reference object's map. A null reference object yields null.
+inline Creature* DcGetCreature(WorldObject const* ref, ObjectGuid guid)
+{
+    return (ref && ref->FindMap()) ? ref->FindMap()->GetCreature(guid) : nullptr;
+}
+inline Unit* DcGetUnit(WorldObject const* ref, ObjectGuid guid)
+{
+    return (ref && ref->FindMap()) ? ref->FindMap()->GetUnit(guid) : nullptr;
+}
+inline GameObject* DcGetGameObject(WorldObject const* ref, ObjectGuid guid)
+{
+    return (ref && ref->FindMap()) ? ref->FindMap()->GetGameObject(guid) : nullptr;
+}
+inline DynamicObject* DcGetDynamicObject(WorldObject const* ref, ObjectGuid guid)
+{
+    return (ref && ref->FindMap()) ? ref->FindMap()->GetDynamicObject(guid) : nullptr;
+}
