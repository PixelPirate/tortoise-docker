+-- the run. Shown only in tiny mode.
+tinyPullToggle = CreateFrame("Button", "DungeonClearTinyPull", frame)
+tinyPullToggle:SetAllPoints(tinyPullDot)
+tinyPullToggle:EnableMouse(true)
