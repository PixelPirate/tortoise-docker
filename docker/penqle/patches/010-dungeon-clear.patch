+// ---- difficulty -------------------------------------------------------------
+// AzerothCore parameterises dungeons by difficulty; the Shyalya host grew a
+// degenerate `typedef int Difficulty` (always DUNGEON_DIFFICULTY_NORMAL) so
+// ported code keeps its call shape. Penqle predates the concept entirely —
+// no header on this core names the type — so the same degenerate typedef
+// lives here, and the Map/Player difficulty accessors the Shyalya core added
+// become free helpers (a module cannot add members to core classes, and this
+// core has no member to alias). On 1.12 every dungeon is normal-mode; the
+// heroic constant exists so the difficulty-gate comparisons compile, and
+// their `.Heroic` config variants simply never fire (documented in the
+// conf.dist).
+typedef int Difficulty;
+constexpr Difficulty DUNGEON_DIFFICULTY_NORMAL = 0;
+constexpr Difficulty DUNGEON_DIFFICULTY_HEROIC = 1;
+constexpr Difficulty MAX_DUNGEON_DIFFICULTY = 1;
+
+inline Difficulty DcDifficultyOf(Map const* map) { return DUNGEON_DIFFICULTY_NORMAL; }
+inline Difficulty DcPlayerDifficulty(Player const* /*player*/) { return DUNGEON_DIFFICULTY_NORMAL; }
+inline void DcSetPlayerDifficulty(Player* /*player*/, Difficulty) {}
