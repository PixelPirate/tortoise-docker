+// The donor core's Unit::EngageWithTarget — "get added to that unit's aggro
+// list without a fight" (SetInCombatWith + zero threat). Penqle spells the
+// pair out; the free helper keeps the ported call shape.
+inline void DcEngageWithTarget(Unit* self, Unit* target)
+{
+    if (!self || !target)
+        return;
+    self->SetInCombatWith(target);
+    self->AddThreat(target, 0.0f);
