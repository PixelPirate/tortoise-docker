+        if (!hadronox || !hadronox->IsAlive() || !hadronox->AI())
+            return ObjectiveArriveResult::Done;  // dead/gone — nothing left to wait for
+
+        return hadronox->AI()->GetData(AN_HADRONOX) == 0 ? ObjectiveArriveResult::Done
