+                    << "stage " << s.order << " cylinder " << (in ? "holds" : "misses")
+                    << " a member of pack " << j
+                    << " — a stage that swallowed a neighbour would target the wrong "
+                       "pack, and one that missed its own would never retire";
+            }
+    }
+}
