diff --git a/ai/dungeonclear/compat/playerbot/BotSlots.h b/ai/dungeonclear/compat/playerbot/BotSlots.h
new file mode 100644
index 0000000..485d72d
--- /dev/null
+++ b/ai/dungeonclear/compat/playerbot/BotSlots.h
@@ -0,0 +1,41 @@
+/*
+ * TortoiseBots compat: bot-slot accessors.
+ *
+ * The donor host (Shyalya's playerbots integration) moved the bot pointers
+ * out of Player into module slots behind these free functions: GetBotAI,
+ * GetBotMgr, IsRealPlayer. TortoiseBots resolves the AI through the module's
+ * own PlayerbotAIStorage (GET_PLAYERBOT_AI) and the master's bot set through
+ * the PlayerbotMgr compat view (see ../PlayerbotMgr.h), so the names keep
+ * their donor shapes and map onto those. The donor's SetBotAI / SetBotMgr /
+ * CreateBotAI / RemoveBotAI / CreateBotMgr / RemoveBotMgr lifecycle had no
+ * callers inside the dungeon-clear module (the host owns the lifecycle
+ * through the Headless adapter), so they are not re-declared here.
+ */
+
+#ifndef DC_TORTOISE_BOT_SLOTS_H
+#define DC_TORTOISE_BOT_SLOTS_H
+
+#include "playerbot/playerbot.h"
+#include "playerbot/PlayerbotAI.h"
+#include "runtime/PlayerbotAIStorage.h"
+#include "PlayerbotMgr.h"
+
+inline PlayerbotAI* GetBotAI(Player const* player)
+{
+    return player ? GET_PLAYERBOT_AI(const_cast<Player*>(player)) : nullptr;
+}
+
+inline PlayerbotMgr* GetBotMgr(Player const* player)
+{
+    return player ? GET_PLAYERBOT_MGR(const_cast<Player*>(player)) : nullptr;
+}
+
+// No bot AI of any kind: a person on a game client. The null check is
+// load-bearing — GET_PLAYERBOT_AI(nullptr) dereferences nothing but the
+// storage lookup expects a live player, so gate first.
+inline bool IsRealPlayer(Player const* player)
+{
+    return player && !GetBotAI(player);
+}
+
+#endif
