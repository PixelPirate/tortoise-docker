+-- dropdown). Mirrors the client's ITEM_QUALITY_COLORS / ITEM_QUALITYn_DESC but
+-- hardcoded so the colored entries render identically regardless of locale.
+local QualityInfo = {
+    [0] = { name = "Poor",      hex = "ff9d9d9d" },
+    [1] = { name = "Common",    hex = "ffffffff" },
