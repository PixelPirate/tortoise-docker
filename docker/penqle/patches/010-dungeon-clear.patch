+++ b/ai/dungeonclear/compat/Playerbots.h
@@ -0,0 +1,40 @@
+#ifndef DC_COMPAT_PLAYERBOTS_H
+#define DC_COMPAT_PLAYERBOTS_H
+
+// mod-playerbots ships one umbrella header that pulls in the AI framework and
+// defines GET_PLAYERBOT_AI. The vendored ike3 tree here has the same classes
+// under different paths and no umbrella, so this is it.
+//
+// GET_PLAYERBOT_AI maps onto the module's own PlayerbotAIStorage accessor
+// (the headless runtime registers every live AI there). GET_PLAYERBOT_MGR
+// and the random-bot manager are TortoiseBots compat shims in this folder:
+// PlayerbotMgr.h adapts the donor's per-master holder onto BotManager,
+// RandomPlayerbotMgr.h adapts the donor's rotation manager onto
+// BotManager/RandomBotFacade, and BotSlots.h keeps the donor slot accessors
+// on the same seams. The two compat managers resolve by flat name because
+// this compat folder is on the include path for this module's TUs.
+
+#include "playerbot/playerbot.h"
+#include "playerbot/PlayerbotAI.h"
+#include "PlayerbotMgr.h"
+#include "playerbot/PlayerbotAIConfig.h"
+#include "RandomPlayerbotMgr.h"
+#include "playerbot/AiFactory.h"
+#include "playerbot/BotSlots.h"
+#include "playerbot/strategy/AiObject.h"
+#include "playerbot/strategy/AiObjectContext.h"
+#include "playerbot/strategy/Action.h"
+#include "playerbot/strategy/Trigger.h"
+#include "playerbot/strategy/Value.h"
+#include "playerbot/strategy/Strategy.h"
+#include "playerbot/strategy/NamedObjectContext.h"
+
+#ifndef GET_PLAYERBOT_AI
+#define GET_PLAYERBOT_AI(player) GetBotAI(player)
+#endif
+
+#ifndef GET_PLAYERBOT_MGR
+#define GET_PLAYERBOT_MGR(player) DcGetPlayerbotMgr(player)
+#endif
+
+#endif
