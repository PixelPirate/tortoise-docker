+// Position on this core is a bare x/y/z/o struct — the accessors and the
+// distance helpers AzerothCore puts on it do not exist, and a module cannot
+// add members. Free helpers; the ported call sites were rewritten to them
+// mechanically (same math as the AzerothCore originals).
+inline float DcExactDist(Position const& a, Position const& b)
+{
+    float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
+    return std::sqrt(dx*dx + dy*dy + dz*dz);
+}
+inline float DcExactDist(Position const* a, Position const* b)
+{
+    return a && b ? DcExactDist(*a, *b) : 0.0f;
+}
+inline float DcExactDist(Position const& a, Position const* b)
+{
+    return b ? DcExactDist(a, *b) : 0.0f;
+}
+inline float DcExactDist(Position const* a, Position const& b)
+{
+    return a ? DcExactDist(*a, b) : 0.0f;
+}
+inline float DcExactDist2d(Position const& a, Position const& b)
+{
+    float dx = a.x - b.x, dy = a.y - b.y;
+    return std::sqrt(dx*dx + dy*dy);
+}
+inline float DcExactDist2d(Position const* a, Position const* b)
+{
+    return a && b ? DcExactDist2d(*a, *b) : 0.0f;
+}
+inline float DcExactDist2d(Position const& a, Position const* b)
+{
+    return b ? DcExactDist2d(a, *b) : 0.0f;
+}
+inline float DcExactDist2d(Position const* a, Position const& b)
+{
+    return a ? DcExactDist2d(*a, b) : 0.0f;
+}
