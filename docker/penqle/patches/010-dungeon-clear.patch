diff --git a/ai/dungeonclear/compat/RandomPlayerbotMgr.h b/ai/dungeonclear/compat/RandomPlayerbotMgr.h
new file mode 100644
index 0000000..44015a7
--- /dev/null
+++ b/ai/dungeonclear/compat/RandomPlayerbotMgr.h
@@ -0,0 +1,93 @@
+/*
+ * TortoiseBots compat: random-bot manager shim.
+ *
+ * The donor host keeps its rotation-driven random-bot population in
+ * RandomPlayerbotMgr (sRandomPlayerbotMgr). TortoiseBots' population lives in
+ * BotManager/RandomBotService (RNDBOT pool, headless sessions) with the
+ * per-bot value store on RandomBotFacade — a different object with the same
+ * responsibilities. The dungeon-clear test driver (.dc test) talks to the
+ * donor shape, so this shim routes each call to the TortoiseBots equivalent:
+ *
+ *   AddPlayerBot(guid, 0)     BotManager::AddBot — a masterless headless
+ *       login of that character (the account comes from the character row,
+ *       as in the donor's holder). Always called with masterAccountId 0 in
+ *       this module; the driver's under-master logins go through
+ *       PlayerbotMgr::AddPlayerBotForMaster instead.
+ *   LogoutPlayerBot(guid)     BotManager::RemoveBot (full save path).
+ *   GetPlayerBot(guid)        ObjectAccessor lookup of the live bot.
+ *   GetActiveRotationBots()   the module's live random-pool identities
+ *       (BotManager records flagged random) — the set the driver must NOT
+ *       claim characters from.
+ *   SetExternallyManaged      a persisted per-bot marker
+ *       (RandomBotFacade::SetValue) recording that a run owns the character
+ *       while it is logged in.
+ *   GetValue / SetValue / GetValueValidTime — RandomBotFacade, identical
+ *       signatures and store.
+ */
+
+#ifndef DC_TORTOISE_RANDOMPLAYERBOTMGR_H
+#define DC_TORTOISE_RANDOMPLAYERBOTMGR_H
+
+#include "playerbot/playerbot.h"
+#include "runtime/BotManager.h"
+#include "playerbot/RandomBotFacade.h"
+#include "ObjectAccessor.h"
+
+class RandomPlayerbotMgr
+{
+public:
+    static RandomPlayerbotMgr& instance()
+    {
+        static RandomPlayerbotMgr mgr;
+        return mgr;
+    }
+
+    bool AddPlayerBot(uint32 guidLow, uint32 /*masterAccountId*/)
+    {
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        if (TortoiseBots::BotManager::Instance().IsBot(guid))
+            return false;
+        uint32 accountId = sObjectMgr.GetPlayerAccountIdByGUID(guidLow);
+        if (!accountId)
+            return false;
+        return TortoiseBots::BotManager::Instance().AddBot(accountId, guid);
+    }
+
+    void LogoutPlayerBot(uint32 guidLow)
+    {
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        TortoiseBots::BotManager::Instance().RemoveBot(guid, true);
+    }
+
+    Player* GetPlayerBot(uint32 guidLow) const
+    {
+        return ObjectAccessor::FindPlayer(ObjectGuid(HIGHGUID_PLAYER, guidLow));
+    }
+
+    std::list<uint32> GetActiveRotationBots()
+    {
+        std::list<uint32> out;
+        for (Player* bot : TortoiseBots::BotManager::Instance().GetAllBots())
+            if (bot && TortoiseBots::BotManager::Instance().IsRandomBot(bot->GetObjectGuid()))
+                out.push_back(bot->GetObjectGuid().GetCounter());
+        return out;
+    }
+
+    // Persistence-backed marker: a run owns this character while logged in.
+    void SetExternallyManaged(uint32 lowGuid, bool on)
+    {
+        sRandomBotFacade.SetValue(lowGuid, "dc-externally-managed", on ? 1u : 0u);
+    }
+
+    uint32 GetValue(Player* bot, std::string type) { return sRandomBotFacade.GetValue(bot, type); }
+    uint32 GetValue(uint32 bot, std::string type) { return sRandomBotFacade.GetValue(bot, type); }
+    int32 GetValueValidTime(uint32 bot, std::string event) { return sRandomBotFacade.GetValueValidTime(bot, event); }
+    void SetValue(uint32 bot, std::string type, uint32 value, std::string data = "", int32 validIn = -1)
+    { sRandomBotFacade.SetValue(bot, type, value, data, validIn); }
+    void SetValue(Player* bot, std::string type, uint32 value, std::string data = "", int32 validIn = -1)
+    { sRandomBotFacade.SetValue(bot, type, value, data, validIn); }
+};
+
+#define sRandomPlayerbotMgr RandomPlayerbotMgr::instance()
+
+#endif
