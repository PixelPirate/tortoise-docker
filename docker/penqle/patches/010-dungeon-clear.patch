+    idx             INTEGER NOT NULL,
+    name            TEXT,
+    killed          INTEGER,
+    wiped           INTEGER,
+    PRIMARY KEY (plan_id, idx)
+);
+
+CREATE TABLE IF NOT EXISTS plan_trash_wipes (
+    plan_id         TEXT NOT NULL REFERENCES plans (plan_id) ON DELETE CASCADE,
+    idx             INTEGER NOT NULL,
+    name            TEXT,
+    count           INTEGER,
+    PRIMARY KEY (plan_id, idx)
