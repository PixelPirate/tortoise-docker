+tinyPullDot = frame:CreateTexture(nil, "OVERLAY")
+tinyPullDot:SetWidth(16); tinyPullDot:SetHeight(16)  -- 1.12: kein SetSize
+tinyPullDot:SetPoint("LEFT", tinyIndicator, "RIGHT", 6, 0)
