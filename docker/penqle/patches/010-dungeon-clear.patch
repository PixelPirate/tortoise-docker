+                                        {222.65f, -20.81f}, {228.56f, -16.65f},
+                                        {227.31f, -22.97f}, {230.53f, -20.94f}}),
+              kPullSpellRange);
+    EXPECT_LT(nearestSpawnDist(West(), {{225.52f, 16.98f}, {222.50f, 20.46f},
+                                        {228.52f, 17.92f}, {230.19f, 19.71f},
+                                        {224.13f, 23.29f}, {228.04f, 23.75f}}),
