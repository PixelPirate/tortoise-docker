+    // Combat drops for real -> streak cleared, ordinary floors apply again.
+    EXPECT_TRUE(DungeonClearMath::MayDriveWhileFlagged(false, false, 1000 + grace, grace, party));
+    EXPECT_EQ(party, 0u);
