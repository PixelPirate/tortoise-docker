+# clean_run.jsonl — a healthy boss-approach progression (one synthetic run,
+# guid 12345). Round-trip + replay sanity: a normal clear must decide to these
+# verdicts. Lines are the exact format DungeonClearApproachIo::ToJsonl emits, so
+# a live capture drops in alongside these unchanged. (# lines are skipped.)
+{"guid":12345,"tick":1000,"verdict":"IssueSplineWindow","engageDist":100,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+{"guid":12345,"tick":1100,"verdict":"RideLiveGlide","engageDist":80,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":true,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+{"guid":12345,"tick":1200,"verdict":"Pursue","engageDist":35,"engageRange":22,"posStuckTicks":0,"canPursue":true,"pursuitFailTicks":2,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+{"guid":12345,"tick":1300,"verdict":"FinalApproach","engageDist":30,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":true,"hopIsJump":false,"doneNotEngagedTicks":3,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+{"guid":12345,"tick":1400,"verdict":"RebuildAndYield","engageDist":20,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":true,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
diff --git a/ai/dungeonclear/t/fixtures/historical_freezes.jsonl b/ai/dungeonclear/t/fixtures/historical_freezes.jsonl
