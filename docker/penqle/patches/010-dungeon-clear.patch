--- /dev/null
+++ b/ai/dungeonclear/t/fixtures/historical_freezes.jsonl
@@ -0,0 +1,26 @@
+# historical_freezes.jsonl — one line per documented live freeze/stutter
+# (project memory), frozen as the observation that produced it and the verdict
+# that resolves it. Each is a permanent regression: if a future change to
+# DecideApproach would reintroduce the freeze, the replay test diverges here.
+# guid 999 = synthetic capture. (# lines are skipped.)
+#
+# dc-async-pathfinding: async build in flight reads as "wait", not unreachable.
+{"guid":999,"tick":1,"verdict":"PlanRouteWait","engageDist":100,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":false,"asyncPending":true,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-direct-pursuit-freeze: at the fail limit the latch trips and the long-path takes over (no pursuit loop).
+{"guid":999,"tick":2,"verdict":"IssueSplineWindow","engageDist":40,"engageRange":22,"posStuckTicks":0,"canPursue":true,"pursuitFailTicks":5,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-path-ends-short-livelock: budget spent, landlocked dead-end stalls (surfaces dc skip) instead of looping a 0-point rebuild.
+{"guid":999,"tick":3,"verdict":"Stall","engageDist":30,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":true,"hopIsJump":false,"doneNotEngagedTicks":15,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-water-swim-legs: no navmesh route but water between -> swim leg, not stall.
+{"guid":999,"tick":4,"verdict":"Swim","engageDist":100,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":false,"asyncPending":false,"startFarFromPoly":false,"waterBetween":true,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-path-ends-short-livelock (no escape): genuinely unreachable, no water -> stall.
+{"guid":999,"tick":5,"verdict":"Stall","engageDist":100,"engageRange":22,"posStuckTicks":0,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":false,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-posstuck-false-positive (the trip case): once posStuck genuinely reaches the limit, recovery is correct.
+{"guid":999,"tick":6,"verdict":"StuckRecover","engageDist":100,"engageRange":22,"posStuckTicks":5,"canPursue":false,"pursuitFailTicks":0,"allowRecoveryMoves":true,"pathReachable":true,"asyncPending":false,"startFarFromPoly":false,"waterBetween":false,"offPath":false,"hopDone":false,"hopIsJump":false,"doneNotEngagedTicks":0,"splineRunning":false,"offLine":false,"haveSplineWindow":true,"stuckTickLimit":5,"pursuitFailLimit":5,"doneNotEngagedLimit":15}
+# dc-resnap-forward-only: drifted off the corridor past the tick budget -> resnap/rebuild.
