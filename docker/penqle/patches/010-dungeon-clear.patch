+// Creature formations. The donor core named the member Creature::GetFormation;
+// Penqle spells it GetCreatureGroup (same pointer, per CreatureGroups.h). A
+// group's identity on Penqle is its leader guid — there is no numeric id — so
+// DcFormationId hands out the leader's guid counter, which is exactly what
+// the formation is keyed by in the DB and stable across the group's life.
+#include "CreatureGroups.h"
+inline CreatureGroup const* DcGetFormation(Creature const* c)
+{
+    return c ? c->GetCreatureGroup() : nullptr;
+}
+inline uint32 DcFormationId(CreatureGroup const* group)
+{
+    return group ? group->GetLeaderGuid().GetCounter() : 0u;
+}
