+// Non-owning navmesh alias. Penqle's MMapManager owns its dtNavMesh for the
+// process lifetime, so the donor's shared_ptr pin maps to a plain alias (the
+// donor's getter existed to survive ITS core unloading meshes between maps).
+#include "Maps/MoveMap.h"
+inline std::shared_ptr<dtNavMesh> DcMMapNavMeshAlias(Map const* map)
+{
