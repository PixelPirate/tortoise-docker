+template <class Out>
+inline void DcCollectLoadedCreatures(WorldObject const* center, float radius, Out& out)
+{
+    if (!center)
+        return;
+    DcGrid::AllUnitsInRange check(center, radius);
+    MaNGOS::UnitListSearcher<DcGrid::AllUnitsInRange> searcher(out, check);
+    Cell::VisitAllObjects(center, searcher, radius, /*dont_load*/ true);
+}
+template <class Out>
+inline void DcCollectLoadedGameObjects(WorldObject const* center, float radius, Out& out)
+{
+    if (!center)
+        return;
+    MaNGOS::AllGameObjectsInRange check(center, radius);
+    MaNGOS::GameObjectListSearcher<MaNGOS::AllGameObjectsInRange> searcher(out, check);
+    Cell::VisitAllObjects(center, searcher, radius, /*dont_load*/ true);
+}
