+    ended_at_ms     INTEGER,
+    started_at      TEXT,
+    duration_s      INTEGER,
+    result          TEXT,
+    abort_reason    TEXT,
+    launched        INTEGER,
+    succeeded       INTEGER,
+    failed          INTEGER,
+    dur_min_s       INTEGER,
+    dur_median_s    INTEGER,
+    dur_avg_s       INTEGER,
+    dur_max_s       INTEGER,
