+-- Layout saving on drag stop
+frame:SetScript("OnDragStop", function()
+    local self = this  -- 1.12: Handler bekommen keine Argumente
+    self.isMoving = nil
+    self:StopMovingOrSizing()
+    local point, _, relativePoint, xOfs, yOfs = self:GetPoint()
