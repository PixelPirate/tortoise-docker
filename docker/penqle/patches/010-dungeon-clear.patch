+    GameTooltip:AddLine("Left-click: free-flying camera.", 0.8, 0.8, 0.8, true)
+    GameTooltip:AddLine("Right-click: follow cam \226\128\148 your view rides the tank.",
+        0.8, 0.8, 0.8, true)
