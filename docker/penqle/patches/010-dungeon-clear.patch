+// AzerothCore's ObjectAccessor::FindConnectedPlayer: any session-connected
+// character, in world or not. This core splits the two (FindPlayer /
+// FindPlayerNotInWorld); prefer the in-world hit, fall through to the
+// connected-but-not-in-world one (teleporting, logout-pending).
+inline Player* DcFindConnectedPlayer(ObjectGuid guid)
+{
+    if (Player* inWorld = ObjectAccessor::FindPlayer(guid))
+        return inWorld;
+    return ObjectAccessor::FindPlayerNotInWorld(guid);
+}
