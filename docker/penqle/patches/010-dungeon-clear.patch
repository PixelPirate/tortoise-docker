+    { 43, 61965, 6 }, // Vangros          (Turtle custom, 693yd on from SKUM - and no
+                      //                   corridor at all from Pythas, which is why he
+                      //                   comes after Skum and not before)
+    { 43, 61968, 7 }, // Zandara Windhoof (Turtle custom, 1229yd)
