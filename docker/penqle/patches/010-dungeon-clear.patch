+                 m.get("botState", ""),
+                 "" if m.get("online") else "OFFLINE"] for m in members]
+        out += table(rows, ["name", "guid", "state", "hp", "mp", "distTank", "", "victim",
+                            "strat", "engine", ""])
+        out += render_combat_blame(members)
+
+    roster = d.get("roster") or []
