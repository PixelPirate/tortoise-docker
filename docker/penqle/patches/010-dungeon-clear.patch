new file mode 100644
index 0000000..7e56778
--- /dev/null
+++ b/ai/dungeonclear/compat/PlayerbotMgr.h
@@ -0,0 +1,129 @@
+/*
+ * TortoiseBots compat: per-master bot holder.
+ *
+ * The donor host (Shyalya's playerbots integration) keeps every logged-in bot
+ * in a per-master PlayerbotMgr session container, reached through
+ * GET_PLAYERBOT_MGR(player). TortoiseBots has no PlayerbotMgr: bots log in
+ * through the headless-session runtime owned by BotManager, and a bot's
+ * master is the BotRecord::masterGuid field. The dungeon-clear test driver
+ * (.dc test) is written against the donor shape — AddPlayerBot under a GM's
+ * account, GetAllBots/GetPlayerBot on the way in, LogoutPlayerBot on
+ * teardown — so this shim gives those calls the same semantics on top of
+ * BotManager:
+ *
+ *   AddPlayerBot(guid, 0)          BotManager::AddBot — the masterless login
+ *       path (the driver's roster members; the account is resolved from the
+ *       character, which is what the donor's holder did too).
+ *   AddPlayerBotForMaster(guid, m) BotManager::AddBotWithMaster — the
+ *       headless login of a specific character under a live master.
+ *   LogoutPlayerBot(guid)          BotManager::RemoveBot — the full
+ *       save-and-remove path, not a bare session drop.
+ *   GetPlayerBot(guid)             ObjectAccessor lookup of the live Player,
+ *       restricted to characters BotManager owns.
+ *   GetAllBots()                   the BotRecord set whose master is this
+ *       holder's player (live in-world bots only).
+ *
+ * This is a view, not a container: it holds the master's guid and asks
+ * BotManager on every call, so concurrent runs and the module's own reaper
+ * see one consistent world state. GET_PLAYERBOT_MGR hands out a shared
+ * per-thread scratch view (re-seated on every call) instead of allocating —
+ * the driver's call sites use it one expression at a time on the world
+ * thread, never nested, and a view holds nothing to dangle. It is NOT a
+ * stub: every method resolves to the real runtime operation the donor's
+ * method performed.
+ */
+
+#ifndef DC_TORTOISE_PLAYERBOTMGR_H
+#define DC_TORTOISE_PLAYERBOTMGR_H
+
+#include "playerbot/playerbot.h"
+#include "runtime/BotManager.h"
+#include "ObjectAccessor.h"
+
+class PlayerbotMgr
+{
+public:
+    typedef std::map<uint32, Player*> PlayerBotMap;
+
+    explicit PlayerbotMgr(Player* master) : _master(master) {}
+
+    Player* GetMaster() const { return _master; }
+
+    // Live bots under this master. Keyed by low guid, matching the donor's
+    // PlayerBotMap shape (the only caller counts them).
+    PlayerBotMap GetAllBots() const
+    {
+        PlayerBotMap bots;
+        if (!_master)
+            return bots;
+        for (Player* bot : TortoiseBots::BotManager::Instance().GetBotsForMaster(_master->GetObjectGuid()))
+            bots[bot->GetObjectGuid().GetCounter()] = bot;
+        return bots;
+    }
+
+    Player* GetPlayerBot(uint32 guidLow) const
+    {
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        TortoiseBots::BotRecord const* record = TortoiseBots::BotManager::Instance().FindBot(guid);
+        if (!record)
+            return nullptr;
+        return ObjectAccessor::FindPlayer(guid);
+    }
+
+    // Masterless login: the account is the character's own (roster members
+    // log in detached from any GM). Returns false when the runtime refuses
+    // (already in world, shutdown in progress), like the donor's holder.
+    bool AddPlayerBot(uint32 guidLow, uint32 /*masterAccountId*/ = 0)
+    {
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        if (TortoiseBots::BotManager::Instance().IsBot(guid))
+            return false;
+        uint32 accountId = sObjectMgr.GetPlayerAccountIdByGUID(guidLow);
+        if (!accountId)
+            return false;
+        return TortoiseBots::BotManager::Instance().AddBot(accountId, guid);
+    }
+
+    // Login under a live master. The donor keyed ownership by the MASTER's
+    // account id; BotManager wants the master's guid, which is the stronger
+    // identity (it is what BotRecord::masterGuid carries).
+    bool AddPlayerBotForMaster(uint32 guidLow, Player* master)
+    {
+        if (!master)
+            return AddPlayerBot(guidLow, 0);
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        if (TortoiseBots::BotManager::Instance().IsBot(guid))
+            return false;
+        uint32 accountId = sObjectMgr.GetPlayerAccountIdByGUID(guidLow);
+        if (!accountId)
+            return false;
+        return TortoiseBots::BotManager::Instance().AddBotWithMaster(accountId, guid, master->GetObjectGuid());
+    }
+
+    void LogoutPlayerBot(uint32 guidLow, bool /*allowInstant*/ = true, bool /*forDelete*/ = false)
+    {
+        ObjectGuid guid = ObjectGuid(HIGHGUID_PLAYER, guidLow);
+        TortoiseBots::BotManager::Instance().RemoveBot(guid, true);
+    }
+
+private:
+    Player* _master;
+};
+
+// Shared per-thread scratch view, re-seated per call (see the class comment).
+// The driver's masterless roster path and a real GM's run both resolve here.
+inline PlayerbotMgr* DcGetPlayerbotMgr(Player* player)
+{
+    static thread_local PlayerbotMgr scratch(nullptr);
+    scratch = PlayerbotMgr(player);
+    return &scratch;
+}
+
+// The donor host kept one PlayerbotMgr per logged-in player, created on
+// login. TortoiseBots masters are ordinary players, and the driver's "does
+// this player have a holder" test is really "is this a live player" — always
+// true for a connected Player object here. A null player gets a null
+// manager, which is what every caller null-checks.
+#define GET_PLAYERBOT_MGR(player) DcGetPlayerbotMgr(player)
+
+#endif
diff --git a/ai/dungeonclear/compat/Playerbots.h b/ai/dungeonclear/compat/Playerbots.h
new file mode 100644
index 0000000..eec7430
