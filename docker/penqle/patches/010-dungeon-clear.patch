+
+CREATE TABLE IF NOT EXISTS plan_verdicts (
+    plan_id         TEXT NOT NULL REFERENCES plans (plan_id) ON DELETE CASCADE,
+    verdict         TEXT NOT NULL,
+    count           INTEGER,
+    PRIMARY KEY (plan_id, verdict)
