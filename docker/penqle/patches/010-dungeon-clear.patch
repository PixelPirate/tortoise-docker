+                 o.get("status", ""), o.get("doneVia", ""), o.get("encounterIndex", ""),
+                 ("TARGET" if o.get("isTarget") else "") + (" sticky" if o.get("isSticky") else "")]
+                for o in roster]
+        out.append("  objective roster:")
