+            { 11488, 20 },  // Illyanna Ravenoak
+            { 11487, 30 },  // Magister Kalendris
+            { 11496, 45 },  // Immol'thar (after all five pylons)
+            { 11486, 50 },  // Prince Tortheldrin (last)
