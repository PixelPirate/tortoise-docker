@@ -236,6 +236,16 @@ AiPlayerbot.DisableActivityPriorities = 1
 # Limit combat activity for slight performance boost.
 #AiPlayerbot.LimitCombatActivity = 0
 
+# Crowd control inside non-raid dungeons: there is no config key for this, the
+# behavior is always on. The generic per-class "cc" strategies do not fire
+# while the bot is in a non-raid dungeon, so bots will not cast their generic
+# CC spells (Polymorph, Shackle Undead, Turn Undead, Scare Beast, Hibernate,
+# Freezing Trap, Sap, Entangling Roots, Banish, Fear) on dungeon trash - a
+# CC'd mob that breaks out early aggros nearby packs and can wipe the group.
+# Dungeon instance strategies keep their own named CC, and open world, raids
+# and battlegrounds keep generic CC. Ported from mod-playerbots PR #2648.
+# Implementation-verified, gameplay-untested.
+
 # Percentage of fully active bots. Default is 10, higher numbers may affect performance
 # AiPlayerbot.botActiveAlone = 10
 
@@ -420,6 +430,11 @@ AiPlayerbot.BotLogFile =
 # The summon command can be used without restriction by non-gms.
 # AiPlayerbot.NonGmFreeSummon = 0
 
+# Bots will be automatically summoned to the player when they accept a group
+# invitation (if they are beyond sight range or on another map). Ported from
+# mod-playerbots.
+# AiPlayerbot.SummonWhenGroup = 0
+
 # Bots will put their talentspec in guild notes when they change/tell their talents if they have the rights.
 # AiPlayerbot.TalentsInPublicNote = 0
 
@@ -1255,6 +1270,23 @@ AiPlayerbot.RpgDistance = 200
 # Bot can flee for enemy
 AiPlayerbot.FleeingEnabled = 1
 
+# When a ready check is issued out of combat, bots refresh missing/short buffs
+# before reporting ready. A bot that still has buff work it can perform stays
+# not-ready until the ready check ends; this includes missing reagents (the
+# cast is attempted and fails). Bots with strategy sets saved before this
+# feature keep their saved set - reset their strategies or use "nc +force
+# rebuff" to opt them in. The "rebuff" chat command starts the same buff pass
+# without a ready check and works regardless of this setting.
+# Default: 0 (disabled)
+AiPlayerbot.ForceRebuffOnReadyCheck = 0
+
+# During a force-rebuff pass (ready check or the "rebuff" command), a buff is
+# topped off (recast) once it drops more than this many seconds below its full
+# duration, so buffs are refreshed toward maximum remaining time to last the
+# fight. The effective margin never drops below the time the pass has already
+# run, so small values are safe.
+# Default: 60
+AiPlayerbot.ForceRebuffMarginSecs = 60
 # Universal raid survival (issue #201): bomb carriers run BombRunoutDistance
 # clear of the raid anchor; spread/flank steps use HazardEvasionDistance.
 #AiPlayerbot.BombRunoutDistance = 30.0
